{
  "name": "pi-claude-subscription",
  "version": "0.5.0",
  "private": false,
  "description": "Pi model provider for your Claude subscription via the Claude Agent SDK.",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "claude-code",
    "claude-agent-sdk",
    "claude-subscription"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zottiben/pi-claude-subscription.git"
  },
  "bugs": {
    "url": "https://github.com/zottiben/pi-claude-subscription/issues"
  },
  "homepage": "https://github.com/zottiben/pi-claude-subscription#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "check": "npm run typecheck && npm test",
    "diag:context": "tsx diag/context-size.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "@anthropic-ai/sdk": "^0.134.0",
    "cc-session-io": "^0.4.0",
    "change-case": "^5.4.4",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.86.0",
    "@earendil-works/pi-coding-agent": ">=0.86.0",
    "@earendil-works/pi-tui": ">=0.86.0",
    "typebox": "*"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "^8.12.3"
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typebox": "^1.3.37",
    "typescript": "^7.0.2"
  }
}
