{
  "name": "pi-claude-subscription",
  "version": "0.3.1",
  "private": false,
  "description": "Pi extension that uses your Claude subscription (via the Claude Agent SDK) as a model provider, and adds an AskClaude delegation tool.",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "claude-code",
    "claude-agent-sdk",
    "claude-subscription"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zottiben/pi-claude-subscription.git"
  },
  "bugs": {
    "url": "https://github.com/zottiben/pi-claude-subscription/issues"
  },
  "homepage": "https://github.com/zottiben/pi-claude-subscription#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "check": "npm run typecheck && npm test",
    "diag:context": "tsx diag/context-size.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@anthropic-ai/sdk": "^0.115.0",
    "cc-session-io": "^0.3.1",
    "change-case": "^5.4.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.86.0",
    "@earendil-works/pi-coding-agent": ">=0.86.0",
    "@earendil-works/pi-tui": ">=0.86.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.86.0",
    "@earendil-works/pi-coding-agent": "^0.86.0",
    "@earendil-works/pi-tui": "^0.86.0",
    "@types/node": "^24.13.2",
    "tsx": "^4.23.1",
    "typebox": "^1.3.8",
    "typescript": "^5.9.0"
  }
}
